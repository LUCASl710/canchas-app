# Copiá este archivo a .env y completá los valores.
# El .env real NO se sube al repositorio.

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=canchas_db
# Bases gestionadas que exigen TLS (Aiven, Railway público, etc.)
DB_SSL=false
# Ruta a un ca.pem si el proveedor lo pide.
DB_SSL_CA=
# Conexiones simultáneas del pool (bajar si el plan es chico).
DB_POOL_SIZE=10

# Servidor
PORT=3001
NODE_ENV=development
# 1 cuando está detrás de un proxy (Railway/Render/Nginx).
# En producción se activa solo.
TRUST_PROXY=0
# Uno o varios orígenes separados por coma (frontend prod + previews).
FRONTEND_URL=http://localhost:5173
# Carpeta de videos. En producción conviene un volumen persistente.
UPLOADS_DIR=
# Tamaño máximo por video (MB).
MAX_VIDEO_MB=500

# Seguridad: generar uno nuevo con
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame_por_un_secreto_largo_y_aleatorio

# Rate limit de login/registro (intentos por IP y ventana en ms).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Hora desde la que una franja cobra el precio nocturno (formato HH:MM).
HORA_NOCTURNA_INICIO=20:00

# Cancelación: horas mínimas antes del turno para que un cliente cancele.
HORAS_CANCELACION_MINIMAS=24

# Mercado Pago (credenciales de prueba o producción)
MP_ACCESS_TOKEN=

# URL pública para recibir notificaciones de pago (ej: ngrok).
# En desarrollo local, sin esta URL, Mercado Pago no puede avisar los pagos.
MP_WEBHOOK_URL=

# Solo para `npm run crear-admin` (no los usa el servidor).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Complejo
